{
  "name": "veridoc",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "cf:setup": "node scripts/cloudflare.mjs setup",
    "cf:build": "node scripts/cloudflare.mjs build",
    "cf:dev": "node scripts/cloudflare.mjs dev",
    "cf:deploy": "node scripts/cloudflare.mjs deploy",
    "cf:admin": "node scripts/cloudflare.mjs admin",
    "cf:check": "node scripts/check-cloudflare-runtime.mjs",
    "test": "node --test src/lib/*.test.js server/*.test.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.2",
    "jsqr": "^1.4.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.10",
    "json-rpc-2.0": "1.7.1",
    "miniflare": "5.20261104.0-beta",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "esbuild": "0.28.2",
    "satori": {
      "fflate": "0.8.3"
    }
  }
}
